<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:paddingHorizontal="20dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_title"
        android:textSize="18sp"
        android:textColor="@color/permission_title"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_message"
        android:textSize="14sp"
        android:textColor="@color/permission_text"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 取消按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel"
            android:textSize="15sp"
            android:textColor="@color/permission_text"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/permission_btn_cancel_bg"
            android:layout_marginEnd="12dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- 去设置按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_settings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_go_settings"
            android:textSize="15sp"
            android:textColor="@color/permission_btn_go_text"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/permission_btn_go_bg"
            style="@style/Widget.Material3.Button.TonalButton" />

    </LinearLayout>

</LinearLayout>
