{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShareCopy",
  "version": "0.1.0",
  "identifier": "com.sharecopy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShareCopy",
        "width": 480,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "signing": {
        "keystorePath": "{{ env.ANDROID_KEYSTORE_PATH || 'release.keystore' }}",
        "keystorePassword": "{{ env.ANDROID_KEYSTORE_PASSWORD }}",
        "keyAlias": "{{ env.ANDROID_KEY_ALIAS || 'sharecopy' }}",
        "keyPassword": "{{ env.ANDROID_KEY_PASSWORD }}"
      }
    }
  },
  "plugins": {}
}
